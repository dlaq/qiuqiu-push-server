FROM node:22-alpine AS web
WORKDIR /src
COPY admin/package*.json ./
RUN npm ci --no-audit --no-fund
COPY admin/ ./
RUN npm run build
FROM golang:1.26.0-alpine AS build
WORKDIR /src
COPY server/go.* ./
RUN go mod download
COPY server/ ./
RUN CGO_ENABLED=0 go build -trimpath -o /gateway .
FROM alpine:3.23
RUN apk add --no-cache ca-certificates tzdata && mkdir /data
COPY --from=build /gateway /usr/local/bin/qiuqiu-gateway
COPY --from=web /src/dist /app/admin
COPY licenses/ /app/licenses/
COPY NOTICE /app/NOTICE
ENV QQ_ADMIN_DIR=/app/admin QQ_DATABASE=/data/qiuqiu.db
EXPOSE 8080
ENTRYPOINT ["qiuqiu-gateway"]
